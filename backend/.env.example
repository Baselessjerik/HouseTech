# Copia este archivo a .env (NO se sube a git)
SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
DATABASE_URL=postgres://postgres:postgres@localhost:5432/housetech
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Usa el backend de consola si no se configura SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
